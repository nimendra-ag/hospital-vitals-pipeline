# Copy to .env (cp .env.example .env). Defaults match docker-compose.yml.

# --- Observability ---
PUSHGATEWAY_URL=localhost:9091
# --- Local PostgreSQL container (docker-compose service `postgres`) ---
DATABASE_URL=postgresql://hospital:hospital@localhost:5433/hospital_vitals

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_VITALS_TOPIC=patient-vitals
KAFKA_NUM_PARTITIONS=4

# --- Simulation clock ---
NUM_PATIENTS=12
VITALS_EMIT_INTERVAL_SECONDS=3
SIMULATED_DAY_SECONDS=300

# --- Paths ---
LAB_DATA_DIR=data/lab_results
MASTER_DATASET_DIR=data/master/vitals
REPORT_OUTPUT_DIR=data/reports
SPARK_CHECKPOINT_DIR=./checkpoints
